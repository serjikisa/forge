@BASE_URL = http://localhost:8080

###############################################################################
# Discovery & Health
###############################################################################

### Health check
GET {{BASE_URL}}/health

### API discovery — lists all available endpoints
GET {{BASE_URL}}/

###############################################################################
# Chat (synchronous) — waits for full response
###############################################################################

### Simple question
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "what is 2+2?"
}

### Trigger read_file tool
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "read internal/tui/color.go"
}

### Trigger list_directory tool
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "list the files in cmd/forge/"
}

### Trigger shell_exec tool
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "run go version"
}

### Trigger search_code tool
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "search for func main across all .go files"
}

### Use a specific model
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "explain what forge does in one sentence",
  "model": "llama3.2:latest"
}

### Multi-turn conversation with roles
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "messages": [
    {"role": "system", "content": "You are a helpful coding assistant. Be concise."},
    {"role": "user", "content": "what is a goroutine?"},
    {"role": "assistant", "content": "A goroutine is a lightweight thread managed by the Go runtime."},
    {"role": "user", "content": "how do I start one?"}
  ]
}

###############################################################################
# Chat Stream (SSE) — tokens arrive as server-sent events
###############################################################################

### Streaming response — each token arrives as a separate SSE event
POST {{BASE_URL}}/v1/chat/stream
Content-Type: application/json

{
  "message": "explain what a goroutine is in 2 sentences"
}

### Streaming with model override
POST {{BASE_URL}}/v1/chat/stream
Content-Type: application/json

{
  "message": "list files in internal/agent/",
  "model": "llama3.2:latest"
}

###############################################################################
# Boundary checks — expect tool_error with "outside project directory"
###############################################################################

### read_file outside project — expect tool_error
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "read the file /etc/passwd"
}

### list_directory outside project — expect tool_error
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "list the directory /etc"
}

###############################################################################
# Error cases
###############################################################################

### Empty body — expect 400
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{}

### Invalid JSON — expect 400
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{bad json}

###############################################################################
# Custom System Prompt — override agent identity
###############################################################################

### Change agent name via system prompt
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "messages": [
    {"role": "system", "content": "You are Jarvis, Tony Stark's personal AI assistant. You are witty, helpful, and always address the user as Sir."},
    {"role": "user", "content": "Who are you?"}
  ]
}

### System prompt as code reviewer
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "messages": [
    {"role": "system", "content": "You are a strict code reviewer. Rate code quality 1-10 and list issues."},
    {"role": "user", "content": "read internal/tool/web_search.go and review it"}
  ]
}

###############################################################################
# Web Tools — web_search and web_fetch
###############################################################################

### Web search
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "search the web for Go 1.22 release notes"
}

### Web fetch
POST {{BASE_URL}}/v1/chat
Content-Type: application/json

{
  "message": "fetch the content of https://go.dev/doc/go1.22"
}
